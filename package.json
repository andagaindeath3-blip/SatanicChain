{
  "name": "satanicchain",
  "version": "1.0.0",
  "description": "SatanicChain — EVM L1 (chainId 666, SATAN) + multi-chain dApp + AI 8x8x5",
  "scripts": {
    "unify": "node scripts/unify.js",
    "setup": "bash scripts/setup-all.sh",
    "compile": "node scripts/compile.js",
    "l1": "cd l1 && docker compose up -d",
    "l1:geth": "cd l1 && docker compose up -d",
    "l1:avax:create": "cd avalanche-l1 && bash scripts/create.sh SatanicChain",
    "l1:avax:deploy": "cd avalanche-l1 && bash scripts/deploy.sh SatanicChain local",
    "rpc:check": "node scripts/rpc-check.js",
    "deploy": "node scripts/deploy.js",
    "deploy:satanic": "node scripts/deploy.js --only satanic",
    "deploy:all": "node scripts/deploy.js all",
    "dapp:config": "node scripts/make-dapp-config.js",
    "dapp": "node scripts/serve-dapp.js",
    "relayer": "node relayer/index.js",
    "ai": "node ai/index.js once",
    "ai:watch": "node ai/index.js watch",
    "test": "node scripts/local-run.js",
    "start": "node scripts/unify.js && node scripts/serve-dapp.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "ganache": "^7.9.2",
    "solc": "0.8.26"
  },
  "license": "MIT"
}
