{
  "name": "satanicchain",
  "version": "1.0.0",
  "description": "SatanicChain — EVM L1 (666, SATAN) + global factory/DEX/bridge",
  "scripts": {
    "unify": "node scripts/unify.js",
    "setup": "bash scripts/setup-all.sh",
    "compile": "node scripts/compile.js",
    "l1": "cd l1 && docker compose up -d",
    "l1:prod": "cd production && docker compose up -d",
    "rpc:check": "node scripts/rpc-check.js",
    "deploy": "node scripts/deploy.js",
    "deploy:factory": "node scripts/deploy-factory.js",
    "deploy:factory:all": "node scripts/deploy-factory.js --all",
    "deploy:global": "node scripts/deploy-global.js",
    "deploy:global:base": "node scripts/deploy-global.js --only base",
    "deploy:global:eth": "node scripts/deploy-global.js --only ethereum",
    "deploy:global:bsc": "node scripts/deploy-global.js --only bsc",
    "dapp": "node scripts/serve-dapp.js",
    "relayer": "node relayer/index.js",
    "ai": "node ai/index.js once",
    "launch": "bash scripts/launch-checklist.sh",
    "start": "node scripts/unify.js && node scripts/serve-dapp.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.13.0",
    "ganache": "^7.9.2",
    "solc": "0.8.26"
  },
  "license": "MIT"
}
